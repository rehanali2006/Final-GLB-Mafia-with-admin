<% layout('/layouts/boilerplate') %>

<div class="container mt-5">

    <h2 class="mb-4">Add New Resource</h2>

    <form action="/home/new" method="POST" enctype="multipart/form-data" id="resourceForm">

        <!-- TYPE -->
        <div class="mb-3">

            <label class="form-label">Resource Type</label>

            <select name="type" id="typeSelect" class="form-select" required>

                <option value="">Select Type</option>

                <option value="Notes">Notes</option>
                <option value="Assignment">Assignment</option>
                <option value="PYQ">PYQ</option>
                <option value="Syllabus">Syllabus</option>
                <option value="Lab Manual">Lab Manual</option>

            </select>

            <div class="form-text text-muted" id="typeHint"></div>

        </div>

        <!-- YEAR -->
        <div class="mb-3">

            <label class="form-label">Year</label>

            <select name="year" class="form-select" required>

                <option value="">Select Year</option>

                <option value="1">1st Year</option>
                <option value="2">2nd Year</option>
                <option value="3">3rd Year</option>
                <option value="4">4th Year</option>

            </select>

        </div>

        <!-- BRANCH -->
        <div class="mb-3">

            <label class="form-label">Branch</label>

            <select name="branch" class="form-select" required>

                <option value="">Select Branch</option>

                <option value="CSE">CSE</option>
                <option value="IT">IT</option>
                <option value="ECE">ECE</option>
                <option value="ME">ME</option>
                <option value="EEE">EEE</option>

                <option value="CS-AIML">CS-AIML</option>
                <option value="CS-H">CS-H</option>
                <option value="CS-DS">CS-DS</option>

                <option value="AI-ML">AI-ML</option>
                <option value="AI-DS">AI-DS</option>
                <option value="CS-AI">CS-AI</option>

            </select>

        </div>

        <!-- SECTION -->
        <div class="mb-3">

            <label class="form-label">Section</label>

            <input
                type="text"
                name="section"
                class="form-control"
                placeholder="Enter section (e.g. A)"
            >

        </div>

        <!-- SUBJECT (hidden for Lab Manual / Syllabus) -->
        <div class="mb-3" id="subjectBlock">

            <label class="form-label">Subject</label>

            <select name="subject" id="subjectSelect" class="form-select">

                <option value="">Select Subject</option>

                <% for(let year in subjectsByYear){ %>

                    <optgroup label="Year <%= year %>">

                        <% for(let subject of subjectsByYear[year]){ %>

                            <option value="<%= subject %>">
                                <%= subject %>
                            </option>

                        <% } %>

                    </optgroup>

                <% } %>

            </select>

            <div class="form-text text-muted" id="subjectHint"></div>

        </div>

        <!-- UNIT (hidden for PYQ / Lab Manual / Syllabus) -->
        <div class="mb-3" id="unitBlock">

            <label class="form-label">Unit</label>

            <select name="unit" id="unitSelect" class="form-select">

                <option value="">Select Unit</option>

                <option value="1">Unit 1</option>
                <option value="2">Unit 2</option>
                <option value="3">Unit 3</option>
                <option value="4">Unit 4</option>
                <option value="5">Unit 5</option>

            </select>

        </div>

        <!-- PDF FILE UPLOAD -->
        <div class="mb-3">

            <label class="form-label">Upload PDF</label>

            <input
                type="file"
                name="file"
                class="form-control"
                accept="application/pdf,.pdf"
                required
            >

            <div class="form-text text-muted">
                Only PDF files are accepted. Maximum size: 20MB.
            </div>

        </div>

        <!-- SUBMIT BUTTON -->
        <button class="btn btn-primary" type="submit">

            Upload Resource

        </button>

    </form>

</div>

<script>
(function () {
    const typeSelect = document.getElementById('typeSelect');
    const subjectBlock = document.getElementById('subjectBlock');
    const subjectSelect = document.getElementById('subjectSelect');
    const subjectHint = document.getElementById('subjectHint');
    const unitBlock = document.getElementById('unitBlock');
    const unitSelect = document.getElementById('unitSelect');
    const typeHint = document.getElementById('typeHint');

    // Which types need a subject / unit field at all
    const needsSubject = { "Notes": true, "Assignment": true, "PYQ": true };
    const needsUnit = { "Notes": true, "Assignment": true };

    const hints = {
        "PYQ": "Upload a single PDF with all units (and years) of previous year questions for this subject.",
        "Lab Manual": "Upload the lab manual PDF. No subject or unit needed \u2014 it's a standalone resource.",
        "Syllabus": "Upload one syllabus PDF that covers the whole year (all subjects). No subject or unit needed."
    };

    function updateFormFields() {
        const type = typeSelect.value;

        const showSubject = !!needsSubject[type];
        subjectBlock.style.display = showSubject ? "" : "none";
        subjectSelect.required = showSubject;
        if (!showSubject) subjectSelect.value = "";

        const showUnit = !!needsUnit[type];
        unitBlock.style.display = showUnit ? "" : "none";
        unitSelect.required = showUnit;
        if (!showUnit) unitSelect.value = "";

        typeHint.textContent = hints[type] || "";
    }

    typeSelect.addEventListener('change', updateFormFields);
    document.addEventListener('DOMContentLoaded', updateFormFields);
    updateFormFields();
})();
</script>
