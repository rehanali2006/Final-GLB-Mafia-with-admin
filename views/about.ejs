<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/css/about.css">

<div class="about-hero">
    <h1>ℹ️ About GLB Mafia</h1>
    <p>Built by a student, for students</p>
</div>

<div class="container pb-5">

    <!-- ABOUT -->
    <div class="about-card">
        <h2>What is GLB Mafia?</h2>
        <p>
            GLB Mafia is a resource-sharing hub for GLBajaj students — notes, assignments,
            previous year questions, syllabus and lab manuals, all organized by year, branch,
            subject and unit. It also helps you find your subject teacher's cabin and check the
            college fee structure, so everything you need as a student is in one place.
        </p>
    </div>

    <!-- CONTACT -->
    <div class="about-card">
        <h2>Contact Me</h2>
        <p>Found a bug, have a suggestion, or want to contribute resources? Reach out directly:</p>

        <div class="contact-links">
            <a href="tel:+917985195925" class="contact-btn">
                <i class="bi bi-telephone-fill"></i> +91 79851 95925
            </a>
            <a href="https://wa.me/917985195925" target="_blank" rel="noopener" class="contact-btn whatsapp">
                <i class="bi bi-whatsapp"></i> WhatsApp
            </a>
        </div>
    </div>

    <!-- SUPPORT / APPRECIATION -->
    <div class="about-card support-card">
        <h2>Support the Project 🙏</h2>
        <p>
            GLB Mafia is free and made in my spare time. If it helped you save time before an
            exam, a small appreciation goes a long way — totally optional, no pressure at all!
        </p>

        <img src="/images/paytm-qr.jpeg" alt="Paytm QR Code" class="qr-image">

        <p class="thank-you-note">
            Thank you for using GLB Mafia — every bit of support is appreciated! ❤️
        </p>
    </div>

</div>
